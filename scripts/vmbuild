#!/data/data/com.termux/files/usr/bin/bash
# Build a provisioned Alpine rootfs image for the phone VM.
#
# The guest has no network (vendor tethering HAL is broken), so every package
# must be installed here, on the Termux side, before the image is sealed.
# proot gives apk a believable chroot without root.
set -uo pipefail

ALPINE_VER="${ALPINE_VER:-3.24}"
MIRROR="https://dl-cdn.alpinelinux.org/alpine"
BUILD="$HOME/.local/share/alpinevm/build"
OUT="$HOME/.local/share/alpinevm/rootfs.img"
SIZE="${VM_IMG_SIZE:-4G}"
ROOT="$BUILD/root"

PKGS_DEFAULT="bash coreutils findutils grep sed gawk tar xz file less
  build-base musl-dev linux-headers pkgconf
  git curl wget ca-certificates openssl
  python3 py3-pip
  nodejs npm
  neovim ripgrep fd jq tree htop
  sqlite make cmake
  socat openssh-server openssh-sftp-server ttyd tmux"
PKGS="${VM_PKGS:-$PKGS_DEFAULT}"

say() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }

mkdir -p "$BUILD"
cd "$BUILD"

# --- 1. base rootfs (cached) -------------------------------------------------
if [ ! -d "$ROOT/bin" ]; then
  say "fetching Alpine $ALPINE_VER aarch64 minirootfs"
  FILE=$(curl -fsSL "$MIRROR/v$ALPINE_VER/releases/aarch64/" \
         | command grep -o 'alpine-minirootfs-[0-9.]*-aarch64\.tar\.gz' | head -1)
  [ -n "$FILE" ] || { echo "could not find a minirootfs for v$ALPINE_VER" >&2; exit 1; }
  curl -fsSL "$MIRROR/v$ALPINE_VER/releases/aarch64/$FILE" -o base.tar.gz
  rm -rf "$ROOT"; mkdir -p "$ROOT"
  tar xzf base.tar.gz -C "$ROOT"
  say "base unpacked ($(du -sh "$ROOT" | cut -f1))"
fi

# --- 2. provision with apk under proot --------------------------------------
# HTTP on purpose: apk verifies package signatures with its own keys, and
# apk-3 does not pick up a seeded CA bundle inside proot.
cat > "$ROOT/etc/apk/repositories" <<EOF
${MIRROR/https:/http:}/v$ALPINE_VER/main
${MIRROR/https:/http:}/v$ALPINE_VER/community
EOF
printf 'nameserver 8.8.8.8\nnameserver 1.1.1.1\n' > "$ROOT/etc/resolv.conf"

# The bare minirootfs has no CA bundle, so apk's TLS fails on the very first
# fetch. Seed it from Termux; if that is missing, fall back to plain HTTP --
# apk verifies package signatures with its own keys regardless of transport.
mkdir -p "$ROOT/etc/ssl/certs"
if [ -f "$PREFIX/etc/tls/cert.pem" ]; then
  cp "$PREFIX/etc/tls/cert.pem" "$ROOT/etc/ssl/certs/ca-certificates.crt"
  cp "$PREFIX/etc/tls/cert.pem" "$ROOT/etc/ssl/cert.pem"
else
  sed -i 's|^https://|http://|' "$ROOT/etc/apk/repositories"
fi

say "installing packages (this is the slow part)"
# PATH must be set explicitly: proot does not inherit a usable one into the
# guest rootfs, and apk/busybox then vanish.
# --link2symlink: apk writes its database via hardlink+rename, which plain
# proot cannot emulate -- without this the install succeeds but the package DB
# is never written, leaving apk convinced only the base 16 packages exist.
proot -0 --link2symlink -r "$ROOT" -w /root \
  -b /dev -b /proc -b /sys \
  /usr/bin/env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY \
  -u all_proxy -u ALL_PROXY -u no_proxy -u NO_PROXY \
  PATH=/bin:/sbin:/usr/bin:/usr/sbin HOME=/root \
  /bin/sh -c "apk update --no-cache && apk add --no-cache $(echo $PKGS | tr '\n' ' ')" \
  2>&1 | tail -8

# --- 2b. undo proot's link2symlink -------------------------------------------
# --link2symlink is required for apk's database write, but it replaces every
# hardlink with an ABSOLUTE symlink into the Termux build directory:
#   /usr/bin/gcc -> /data/data/com.termux/.../root/usr/bin/.l2s..apk.7b93...
# Those paths do not exist inside the VM, so the binaries dangle. Materialise
# each one back into a real file before sealing the image.
say "resolving link2symlink artifacts"
python3 - "$ROOT" <<'PYEOF'
import os, shutil, sys
root = sys.argv[1]
fixed = removed = 0
links = []
for dirpath, dirnames, filenames in os.walk(root):
    for name in filenames + dirnames:
        p = os.path.join(dirpath, name)
        if os.path.islink(p):
            t = os.readlink(p)
            if '.l2s.' in t:
                links.append((p, t))
for p, t in links:
    src = t if os.path.isabs(t) else os.path.join(os.path.dirname(p), t)
    if os.path.exists(src):
        os.unlink(p)
        shutil.copy2(src, p)
        fixed += 1
for dirpath, _, filenames in os.walk(root):
    for name in filenames:
        if name.startswith('.l2s.'):
            os.unlink(os.path.join(dirpath, name)); removed += 1
print(f"    materialised {fixed} links, removed {removed} .l2s stubs")
PYEOF

# --- 2c. ssh identity --------------------------------------------------------
# sshd is reached over vsock (adb forward tcp:N vsock:CID:5556), which gives
# scp/sftp for moving work in and out of an otherwise networkless guest.
KEY="$HOME/.local/share/alpinevm/id_vm"
if [ ! -f "$KEY" ]; then
  say "generating VM ssh key"
  ssh-keygen -t ed25519 -N '' -C 'termux->alpine-vm' -f "$KEY" >/dev/null 2>&1
fi
mkdir -p "$ROOT/root/.ssh" "$ROOT/etc/ssh"
cp "$KEY.pub" "$ROOT/root/.ssh/authorized_keys"
chmod 700 "$ROOT/root/.ssh"; chmod 600 "$ROOT/root/.ssh/authorized_keys"
cat >> "$ROOT/etc/ssh/sshd_config" <<'EOF'

# vsock-reached, key-only root login
PermitRootLogin prohibit-password
PubkeyAuthentication yes
PasswordAuthentication no
Subsystem sftp /usr/lib/ssh/sftp-server
EOF
say "generating sshd host keys"
proot -0 --link2symlink -r "$ROOT" -w /root -b /dev -b /proc -b /sys \
  /usr/bin/env PATH=/bin:/sbin:/usr/bin:/usr/sbin HOME=/root \
  /bin/sh -c 'ssh-keygen -A' >/dev/null 2>&1

# --- 3. guest init -----------------------------------------------------------
say "installing guest init"
cp "$(dirname "$0")/guest-init.sh" "$ROOT/init"
chmod +x "$ROOT/init"
mkdir -p "$ROOT/work" "$ROOT/root"
printf 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\nexport HOME=/root\n' > "$ROOT/etc/profile.d/vm.sh"

# --- 4. seal the image -------------------------------------------------------
say "building ext4 image ($SIZE)"
rm -f "$OUT"
mke2fs -q -t ext4 -d "$ROOT" -b 4096 -I 256 -F "$OUT" "$SIZE" 2>&1 | command grep -v '^$' || true
say "done: $OUT ($(du -h "$OUT" | cut -f1)), rootfs $(du -sh "$ROOT" | cut -f1)"
